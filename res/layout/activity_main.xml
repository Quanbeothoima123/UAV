<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F9"
    android:padding="6dp">

    <!-- ================================================================= -->
    <!-- TOP ROW: ARM, DISARM, 3 TELEMETRY CHARTS (Roll, Pitch, Altm), CONNECT -->
    <!-- ================================================================= -->

    <!-- Top Left: ARM & DISARM buttons -->
    <LinearLayout
        android:id="@+id/top_left_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- FLIGHT Container (Kích hoạt Flight Mode & Stream cảm biến) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginEnd="10dp"
            android:layout_marginRight="10dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/button_flight"
                android:layout_width="90dp"
                android:layout_height="40dp"
                android:background="@drawable/btn_flight_bg"
                android:text="FLIGHT"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/text_flight_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Flight (f)"
                android:textColor="#0277BD"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- ARM Container -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginEnd="10dp"
            android:layout_marginRight="10dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/button_arm"
                android:layout_width="90dp"
                android:layout_height="40dp"
                android:background="@drawable/btn_arm_bg"
                android:text="ARM"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Arm (Khởi động)"
                android:textColor="#2E7D32"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- DISARM Container -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/button_disarm"
                android:layout_width="90dp"
                android:layout_height="40dp"
                android:background="@drawable/btn_disarm_bg"
                android:text="DISARM"
                android:textColor="#37474F"
                android:textStyle="bold"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Disarm (Chờ)"
                android:textColor="#C67D00"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Top Far Right: Connect and Settings icon buttons -->
    <LinearLayout
        android:id="@+id/top_right_icons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentRight="true"
        android:layout_alignParentTop="true"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/imageButton_connect"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/custom_button"
            android:contentDescription="@string/menu_connect_ContentDescription"
            android:elevation="2dp"
            android:src="@drawable/ic_action_import_export"
            android:layout_marginEnd="6dp"
            android:layout_marginRight="6dp" />

        <ImageButton
            android:id="@+id/imageButton_settings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/custom_button"
            android:contentDescription="@string/menu_preferences_ContentDescription"
            android:elevation="2dp"
            android:src="@drawable/ic_action_settings_light" />
    </LinearLayout>

    <!-- Top Right: 3 Telemetry Bar Charts (Roll, Pitch, Altm) -->
    <LinearLayout
        android:id="@+id/top_telemetry_group"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_alignParentTop="true"
        android:layout_toStartOf="@+id/top_right_icons"
        android:layout_toLeftOf="@+id/top_right_icons"
        android:layout_marginEnd="10dp"
        android:layout_marginRight="10dp"
        android:orientation="horizontal">

        <se.bitcraze.crazyfliecontrol2.TelemetryBarView
            android:id="@+id/telemetry_roll"
            android:layout_width="85dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_marginRight="6dp" />

        <se.bitcraze.crazyfliecontrol2.TelemetryBarView
            android:id="@+id/telemetry_pitch"
            android:layout_width="85dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_marginRight="6dp" />

        <se.bitcraze.crazyfliecontrol2.TelemetryBarView
            android:id="@+id/telemetry_altm"
            android:layout_width="85dp"
            android:layout_height="match_parent" />
    </LinearLayout>

    <!-- ================================================================= -->
    <!-- BOTTOM STATUS STRIP & LOG CONSOLE (Vietnamese diagnostics)        -->
    <!-- ================================================================= -->
    <LinearLayout
        android:id="@+id/bottom_status_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#E8EEF5"
        android:padding="3dp">

        <TextView
            android:id="@+id/uav_status_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/uav_status_initial"
            android:textColor="#B00020"
            android:textSize="11sp"
            android:maxLines="2" />

        <ScrollView
            android:id="@+id/console_scrollView"
            android:layout_width="140dp"
            android:layout_height="32dp"
            android:visibility="gone"
            android:background="@drawable/stroke_bg">
            <TextView
                android:id="@+id/console_textView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="9sp" />
        </ScrollView>
    </LinearLayout>

    <!-- ================================================================= -->
    <!-- LEFT SIDE: 4-WAY D-PAD (W, A, S, D)                               -->
    <!-- ================================================================= -->
    <RelativeLayout
        android:id="@+id/dpad_container"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentLeft="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="80dp"
        android:layout_marginLeft="80dp">

        <!-- W (Up / Throttle+) -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_dpad_w"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:background="@drawable/btn_dpad_key"
            android:text="W"
            android:textColor="#263238"
            android:textSize="19sp"
            android:textStyle="bold" />

        <!-- A (Left / Yaw Left) -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_dpad_a"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:layout_alignParentLeft="true"
            android:background="@drawable/btn_dpad_key"
            android:text="A"
            android:textColor="#263238"
            android:textSize="19sp"
            android:textStyle="bold" />

        <!-- Center Hub -->
        <View
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_centerInParent="true"
            android:background="#CFD8DC" />

        <!-- D (Right / Yaw Right) -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_dpad_d"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:layout_alignParentRight="true"
            android:background="@drawable/btn_dpad_key"
            android:text="D"
            android:textColor="#263238"
            android:textSize="19sp"
            android:textStyle="bold" />

        <!-- S (Down / Throttle-) -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_dpad_s"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:background="@drawable/btn_dpad_key"
            android:text="S"
            android:textColor="#263238"
            android:textSize="19sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- ================================================================= -->
    <!-- RIGHT SIDE: CIRCULAR KNOB (Roll/Pitch) + KILL BUTTON              -->
    <!-- ================================================================= -->

    <!-- Circular Knob for Roll / Pitch (Centered vertically and balanced with D-pad) -->
    <se.bitcraze.crazyfliecontrol2.CircularKnobView
        android:id="@+id/circular_knob_view"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="50dp"
        android:layout_marginRight="50dp" />

    <!-- KILL Button (Red) at Bottom Right -->
    <LinearLayout
        android:id="@+id/kill_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentRight="true"
        android:layout_above="@+id/bottom_status_bar"
        android:layout_marginEnd="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="6dp"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/button_kill"
            android:layout_width="100dp"
            android:layout_height="38dp"
            android:background="@drawable/btn_kill_bg"
            android:text="KILL"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kill (Khẩn cấp)"
            android:textColor="#B71C1C"
            android:textSize="11sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- ================================================================= -->
    <!-- CENTER COLUMN: TAKEOFF, LANDING, BATTERY GAUGE                    -->
    <!-- ================================================================= -->
    <LinearLayout
        android:id="@+id/center_column"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Takeoff circular button -->
        <LinearLayout
            android:id="@+id/layout_takeoff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/button_takeoff"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/btn_takeoff_bg"
                android:text="⇧"
                android:textColor="#0277BD"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cất cánh (Take off)"
                android:textColor="#01579B"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginStart="8dp"
                android:layout_marginLeft="8dp" />
        </LinearLayout>

        <!-- Landing circular button -->
        <LinearLayout
            android:id="@+id/layout_landing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/button_landing"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/btn_landing_bg"
                android:text="⇩"
                android:textColor="#263238"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hạ cánh (Landing)"
                android:textColor="#263238"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginStart="8dp"
                android:layout_marginLeft="8dp" />
        </LinearLayout>

        <!-- Large Battery Gauge -->
        <se.bitcraze.crazyfliecontrol2.BatteryGaugeView
            android:id="@+id/battery_gauge_view"
            android:layout_width="160dp"
            android:layout_height="64dp" />
    </LinearLayout>

</RelativeLayout>
